# Build do MkDocs (gerado via "mkdocs build" / "mkdocs gh-deploy")
# Não precisa ir para a branch main — a mkdocs gh-deploy publica direto na gh-pages
site/

# Metadados do Windows que às vezes vazam ao compactar pastas baixadas da internet
*Zone.Identifier*

# Diversos
.DS_Store
__pycache__/
*.pyc

# Ambiente virtual Python (se você criar uma venv para o projeto)
.venv/
venv/

# Espaço de revisão privado: rascunhos de posts e o HTML gerado para revisar
# no navegador (scripts/revisar.sh). Nada disso vai para o GitHub.
docs/rascunhos/
revisao/
